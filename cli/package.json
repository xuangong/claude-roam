{
  "name": "claude-roam",
  "version": "0.1.0",
  "description": "Claude Code session roaming sync CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "claude-roam": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:bin": "npm run build:preview && bun build src/index.ts --compile --outfile claude-roam",
    "build:preview": "npm --prefix ../web run build:preview",
    "build:all": "npm run build:preview && npm run build:platforms",
    "build:platforms": "npm run build:macos-arm64 && npm run build:macos-x64 && npm run build:linux-x64 && npm run build:linux-arm64 && npm run build:windows-x64",
    "build:macos-arm64": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/claude-roam-darwin-arm64",
    "build:macos-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/claude-roam-darwin-x64",
    "build:linux-x64": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/claude-roam-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/claude-roam-linux-arm64",
    "build:windows-x64": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/claude-roam-windows-x64.exe",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "bunx @biomejs/biome check src",
    "format": "bunx @biomejs/biome format --write src"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0"
  },
  "dependencies": {
    "commander": "^12.1.0"
  }
}
